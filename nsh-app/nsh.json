{
  "name": "DSH",
  "id": "io.jingtao.dshanywhere",
  "version": "0.1.21",
  "build": 22,
  "appearance": "system",
  "theme": {
    "cssVars": {
      "theme": {
        "font-sans": "Geist, sans-serif",
        "font-mono": "Geist Mono, monospace",
        "radius": "12px"
      },
      "light": {
        "background": "#FFFFFF",
        "foreground": "#171717",
        "card": "#F4F4F4",
        "card-foreground": "#171717",
        "popover": "#FFFFFF",
        "popover-foreground": "#171717",
        "primary": "#171717",
        "primary-foreground": "#FFFFFF",
        "secondary": "#EAEAEA",
        "secondary-foreground": "#171717",
        "muted": "#F4F4F4",
        "muted-foreground": "#666666",
        "accent": "#EAEAEA",
        "accent-foreground": "#171717",
        "destructive": "#FF3B30",
        "border": "#DFDFDF",
        "input": "#D0D0D0",
        "ring": "#2459C4",
        "link": "#171717",
        "live": "#666666",
        "attention": "#B63F24",
        "work-highlight": "#444444"
      },
      "dark": {
        "background": "#000000",
        "foreground": "#F5F5F5",
        "card": "#101010",
        "card-foreground": "#F5F5F5",
        "popover": "#101010",
        "popover-foreground": "#F5F5F5",
        "primary": "#F5F5F5",
        "primary-foreground": "#000000",
        "secondary": "#1B1B1B",
        "secondary-foreground": "#F5F5F5",
        "muted": "#101010",
        "muted-foreground": "#929292",
        "accent": "#1B1B1B",
        "accent-foreground": "#F5F5F5",
        "destructive": "#FF453A",
        "border": "#282828",
        "input": "#343434",
        "ring": "#8BB2FF",
        "link": "#F5F5F5",
        "live": "#929292",
        "attention": "#FF9275",
        "work-highlight": "#B8B8B8"
      }
    }
  },
  "statusBar": {
    "foreground": "auto"
  },
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "clipboard": true,
    "statusBar": true,
    "host": [
      "ui.open",
      "link.state",
      "link.pair",
      "link.scan",
      "link.forget",
      "link.reset",
      "link.path",
      "link.diagnose",
      "link.lastFailure",
      "link.tailcatOnly",
      "files.pick",
      "voice.*",
      "haptic",
      "network.state",
      "app.state",
      "app.info",
      "app.clock",
      "app.language",
      "diagnostics.preferences.read",
      "diagnostics.preferences.write",
      "diagnostics.read",
      "diagnostics.write",
      "diagnostics.clear",
      "diagnostics.resources",
      "diagnostics.share",
      "notify.*"
    ],
    "picker": true,
    "webview": {
      "hosts": []
    },
    "openUrl": {
      "schemes": [
        "https"
      ]
    }
  }
}
